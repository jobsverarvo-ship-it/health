# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)

# 공공데이터포털(data.go.kr) 마이페이지의 '일반 인증키(Decoding)'
DATA_GO_KR_KEY=

# Claude API 키 (console.anthropic.com). 비워 두면 AI 없이 규칙 초안으로 만들어요.
ANTHROPIC_API_KEY=

# 초안 방식: auto(키가 있으면 AI) | ai | rule
HARUON_WRITER=auto
HARUON_MODEL=claude-opus-5-5
HARUON_EFFORT=medium

# 하루에 보내는 정보 개수
TIPS_PER_DAY_FREE=1
TIPS_PER_DAY_MEMBER=3

# 자료원별로 한 번 실행할 때 읽는 페이지 수 (개발 계정은 하루 호출 수 제한이 있어요)
PAGES_PER_RUN=1
MAX_DRAFTS_PER_RUN=10

# 날씨·미세먼지 문장 틀을 매일 자동 승인할지 (문장 틀은 출시 전에 약사가 한 번 검토)
AUTO_APPROVE_TEMPLATES=1

# API 주소가 바뀌면 여기서 덮어쓰기 (예)
# ENDPOINT_DUR_ELDERLY=https://apis.data.go.kr/1471000/DURPrdlstInfoService03/getOdsnAtentInfoList03
