# 이 파일을 복사해 같은 폴더에 .env 라는 이름으로 만들고 값을 채우세요.
# .env 는 GitHub에 올라가지 않습니다(.gitignore). 키와 비밀번호는 .env 에만 적으세요.
# 아무것도 안 채워도 내 컴퓨터에서는 '개발용'으로 돌아갑니다.
#   - 인증 문자: 실제로 보내지 않고 서버 창에 인증번호가 찍힘
#   - 카카오 로그인: 연습 화면이 열림

# development(내 컴퓨터) 또는 production(실제 서비스)
APP_ENV=development

# 사이트 주소. 실제 서비스에서는 https:// 로 시작해야 합니다.
PUBLIC_URL=http://localhost:8000

# 로그인 보안에 쓰는 비밀값. 실제 서비스에서는 꼭 길고 무작위한 값으로 바꾸세요.
# 만드는 법:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# 회원 정보를 저장할 파일 (비워 두면 server/data/app.db)
# DB_PATH=

# 로그인 유지 기간(일)
SESSION_DAYS=30

# ---------------------------------------------------------------- 문자 인증
# console(개발용, 보내지 않음) 또는 solapi(실제 발송)
SMS_PROVIDER=console
# 솔라피 콘솔에서 발급한 API 키와 시크릿, 솔라피에 미리 등록한 발신번호(예: 01012345678)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=

# ---------------------------------------------------------------- 카카오 로그인
# 카카오 개발자 콘솔 [앱] > [플랫폼 키] > [REST API 키]. 비워 두면 개발용 연습 화면이 열립니다.
KAKAO_REST_API_KEY=
# 같은 화면의 [클라이언트 시크릿] 값. 새로 만든 앱은 기본으로 켜져 있으니 꼭 넣으세요.
KAKAO_CLIENT_SECRET=

# 다 넣었으면 확인:  python -m server.check
